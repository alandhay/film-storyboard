# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Either variable name works (RUNWAYML_API_SECRET is the SDK's native name;
# RUNWAY_API_KEY is accepted as an alias by runway_gateway.config).
RUNWAY_API_KEY=your_runway_api_secret_here
# RUNWAYML_API_SECRET=your_runway_api_secret_here
